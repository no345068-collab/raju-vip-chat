<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
body{margin:0;padding:18px;min-height:100vh;background:url('bg.jpg') center/cover fixed no-repeat;font-family:sans-serif;text-align:center}
.page{display:none;max-width:420px;margin:24px auto;background:rgba(255,255,255,.94);border:1px solid #000;border-radius:14px;padding:16px}
.active{display:block}
h1{color:#000;font-size:22px;margin:6px 0}
input{padding:10px;font-size:15px;width:85%;max-width:290px;margin-top:10px;border:1px solid #000;border-radius:6px;background:#fff}
button{padding:10px 14px;font-size:14px;margin-top:10px;margin-right:4px;background:#000;color:#fff;border:none;border-radius:6px}
#chat-list{background:#f8fafc;border-radius:10px;padding:10px;height:240px;overflow-y:auto;text-align:left;margin-top:10px;border:1px solid #000}
.msg{background:#e3f2fd;color:#000;padding:8px;border-radius:8px;margin-bottom:8px;word-wrap:break-word}
.msg img,.msg video{max-width:100%;max-height:170px;border-radius:8px;margin-top:6px;display:block}
</style>
</head>
<body>
<div class="page active" id="page1">
<h1>RAJU PERSONAL VIP CHAT</h1>
<input type="email" id="email" placeholder="Enter your email"><br>
<input type="password" id="pass" placeholder="Create password"><br>
<button onclick="goOTP()">Sign Up & Next</button>
</div>
<div class="page" id="page2">
<h1>OTP VERIFY</h1>
<p id="otp-info"></p>
<input type="text" id="otp-in" placeholder="4-digit OTP" maxlength="4"><br>
<button onclick="goChat()">Verify & Open Chat</button>
</div>
<div class="page" id="page3">
<h1>VIP CHAT LIST</h1>
<div id="chat-list"></div>
<input type="text" id="msg" placeholder="Message likhein ya bolen..."><br>
<input type="file" id="media-in" accept="image/*,video/*" style="display:none" onchange="sendMedia(this)">
<button onclick="sendMsg()">Send</button>
<button onclick="voice()">Mic</button>
<button onclick="document.getElementById('media-in').click()">Photo/Video</button>
</div>
<script>
var otp="";
function showPage(id){
 document.querySelectorAll(".page").forEach(function(p){p.classList.remove("active")});
 document.getElementById(id).classList.add("active");
}
function goOTP(){
 var e=document.getElementById("email").value,p=document.getElementById("pass").value;
 if(!e||p.length<4){alert("Email aur 4+ digit password daalein");return}
 otp=String(Math.floor(1000+Math.random()*9000));
 document.getElementById("otp-info").innerText="Demo OTP: "+otp;
 showPage("page2");
}
function goChat(){
 if(document.getElementById("otp-in").value===otp){showPage("page3")}
 else{alert("Galat OTP")}
}
function addMsg(html){
 var d=document.createElement("div");d.className="msg";d.innerHTML=html;
 var b=document.getElementById("chat-list");b.appendChild(d);b.scrollTop=b.scrollHeight;
}
function sendMsg(){
 var i=document.getElementById("msg"),t=i.value.trim();if(!t)return;
 addMsg("<b>Raju:</b> "+t.replace(/</g,"&lt;"));i.value="";
}
function sendMedia(inp){
 var f=inp.files[0];if(!f)return;
 var u=URL.createObjectURL(f);
 if(f.type.startsWith("image/")){addMsg("<b>Raju:</b> Photo<img src='"+u+"'>")}
 else if(f.type.startsWith("video/")){addMsg("<b>Raju:</b> Video<video src='"+u+"' controls></video>")}
 inp.value="";
}
function voice(){
 var S=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!S){alert("Mic support nahi hai");return}
 var r=new S();r.lang="hi-IN";r.onresult=function(e){document.getElementById("msg").value=e.results[0][0].transcript};r.start();
}
</script>
</body>
</html>
